# ==============================================================================
# Dhaka Tesla Pool - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before running locally or deploying:
# cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=production

# Security & Authentication
# Replace with a strong, random 256-bit secret key in production environments
JWT_SECRET=dhaka-tesla-jwt-production-secret-replace-me

# Database Configuration
# Path to SQLite database file (inside container volume or local filesystem)
DB_FILE=/app/data/dhaka_tesla.sqlite

# Fare Pricing Parameters (Integer Poysha: 1 BDT = 100 Poysha)
# BASE_FARE_POYSHA=3000          # 30.00 BDT flag drop
# RATE_PER_KM_POYSHA=1500        # 15.00 BDT per Km
# POOL_DISCOUNT_PERCENT=25       # 25% pool discount
# MINIMUM_FARE_POYSHA=2500       # 25.00 BDT minimum floor
